{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "jeanfx.vercel.app" }],
      "destination": "https://jeanfxtrading.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "jeanivanfunnel.vercel.app" }],
      "destination": "https://jeanfxtrading.com/$1",
      "permanent": true
    },
    { "source": "/", "destination": "/waitlist", "permanent": false }
  ],
  "rewrites": [
    { "source": "/discord", "destination": "/index.html" },
    { "source": "/apply", "destination": "/index.html" },
    { "source": "/apply-2", "destination": "/index.html" },
    { "source": "/booked", "destination": "/index.html" },
    { "source": "/not-qualified", "destination": "/index.html" },
    { "source": "/waitlist", "destination": "/index.html" }
  ]
}
