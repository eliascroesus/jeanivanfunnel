{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "jeanfx.vercel.app" }],
      "destination": "https://jeanfxtrading.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "jeanivanfunnel.vercel.app" }],
      "destination": "https://jeanfxtrading.com/$1",
      "permanent": true
    },
    { "source": "/", "destination": "/waitlist", "permanent": false },
    { "source": "/redesign/(.*)", "destination": "/$1", "permanent": false },
    { "source": "/apply-2", "destination": "/apply", "permanent": false }
  ],
  "rewrites": [
    { "source": "/waitlist", "destination": "/old/index.html" },
    { "source": "/not-qualified", "destination": "/old/index.html" },
    { "source": "/old/discord", "destination": "/old/index.html" },
    { "source": "/old/apply", "destination": "/old/index.html" },
    { "source": "/old/apply-2", "destination": "/old/index.html" },
    { "source": "/old/booked", "destination": "/old/index.html" },
    { "source": "/old/not-qualified", "destination": "/old/index.html" },
    { "source": "/old/waitlist", "destination": "/old/index.html" }
  ]
}
